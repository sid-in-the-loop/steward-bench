Bootstrap: docker
From: nikolaik/python-nodejs:python3.12-nodejs22-bookworm

%post
    apt-get update -qq
    apt-get install -y -qq --no-install-recommends ripgrep jq tree zip unzip less procps poppler-utils zsh >/dev/null
    rm -rf /var/lib/apt/lists/*
    pip install --quiet --no-cache-dir pandas numpy openpyxl xlrd pypdf PyPDF2 python-docx matplotlib \
        requests pyyaml beautifulsoup4 lxml tabulate scipy pytest
    ln -sf /usr/local/bin/python3 /usr/local/bin/python
