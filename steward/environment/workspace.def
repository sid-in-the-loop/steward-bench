Bootstrap: docker
From: nikolaik/python-nodejs:python3.12-nodejs22-bookworm

%post
    apt-get update -qq
    apt-get install -y -qq --no-install-recommends ripgrep jq tree zip unzip less procps poppler-utils \
        zsh tmux sqlite3 file bc rsync build-essential pkg-config libssl-dev >/dev/null
    rm -rf /var/lib/apt/lists/*
    pip install --quiet --no-cache-dir pandas numpy openpyxl xlrd pypdf PyPDF2 python-docx matplotlib \
        requests pyyaml beautifulsoup4 lxml tabulate scipy pytest uv
    ln -sf /usr/local/bin/python3 /usr/local/bin/python
    curl -fsSL https://go.dev/dl/go1.25.3.linux-amd64.tar.gz | tar -xz -C /usr/local
    export RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path >/dev/null
    chmod -R a+rX /opt/rustup /opt/cargo
    export BUN_INSTALL=/opt/bun
    curl -fsSL https://bun.sh/install | bash >/dev/null
    npm install --global --silent typescript || true
    command -v pnpm || npm install --global --silent --force pnpm || true

%environment
    export RUSTUP_HOME=/opt/rustup
    export PATH=/usr/local/go/bin:/opt/cargo/bin:/opt/bun/bin:$PATH
