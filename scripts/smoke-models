#!/bin/bash
# One minimal tool-call round trip per model, printing the usage each reports
# (steward/smoke.py). Prints its cost bound and calls nothing without --confirm:
#   scripts/smoke-models [--model M ...] [--confirm]
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run python -c 'import sys; from steward.smoke import main; sys.exit(main(sys.argv[1:]))' "$@"
