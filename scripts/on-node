#!/bin/bash
# Run a command on the compute node held by the running `steward-build` job, so heavy checks
# such as `steward check` stay off the shared login node:
#   scripts/on-node uv run steward check --task <id>
# Start the job with: sbatch --account ACCOUNT --partition PARTITION --job-name steward-build
#   --cpus-per-task 16 --gpus-per-node 1 --mem 32G --time 08:00:00 --wrap "sleep 28800"
# Without a running job the command runs here, as before.
set -eu
cd "$(dirname "$0")/.."
job=$(squeue -u "$USER" -h -n steward-build -t R -o %i 2>/dev/null | head -1 || true)
if [ -n "$job" ]; then
    exec srun --jobid "$job" --overlap --ntasks 1 --cpus-per-task 4 --chdir "$PWD" "$@"
fi
exec "$@"
