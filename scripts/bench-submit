#!/bin/bash
# Submit the chain of benchmark jobs: scripts/bench-submit ACCOUNT PARTITION [sbatch options].
# Each job runs for an hour and submits the next; see scripts/bench_job.sh.
set -eu
account=${1:?account}
partition=${2:?partition}
shift 2
cd "$(dirname "$0")/.."
mkdir -p data/cases/sessions/logs
sbatch --account "$account" --partition "$partition" "$@" scripts/bench_job.sh
